                { fr: { text: "Ex1 : Calculer A = (3/4 - 1/2) ÷ (2/3)", answer: "(3/4-2/4)=1/4, puis (1/4)×(3/2)=3/8." } },
                { fr: { text: "Ex2 : Résoudre 2x-5 ≤ 3x+1", answer: "-5-1 ≤ 3x-2x → -6 ≤ x → x ≥ -6." } },
                { fr: { text: "Ex3 : Développer (3x-2)²", answer: "9x² -12x +4." } }
            ]
        },
        bac2023: {
            title: "Bac C 2023 – Cameroun",
            questions: [
                { fr: { text: "Ex1 : Résoudre dans ℂ : z² - 2z + 5 = 0", answer: "Δ = 4-20 = -16 → z = 1 ± 2i." } },
                { fr: { text: "Ex2 : Calculer ∫₀^π/2 sin(2x) dx", answer: "[-cos(2x)/2]₀^π/2 = (1/2) - (-1/2) = 1." } },
                { fr: { text: "Ex3 : Dérivée de f(x)=x·ln x", answer: "ln x + 1." } }
            ]
        }
    };

    // ================= ÉTAT GLOBAL =================
    let currentLang = "fr";
    let currentExam = "college";
    let currentSeries = null;
    let currentQuestions = [];
    let stats = JSON.parse(localStorage.getItem("mathStats")) || [];
    let quizInterval = null;
    let quizActive = false;
    let quizTime = 600;
    let quizScore = 0;
    let quizCurrentQuestion = null;

    // ================= FONCTIONS UTILITAIRES =================
    function escapeHtml(str) {
        if (!str) return "";
        return str.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    // ================= STATISTIQUES =================
    function updateStats() {
        const total = stats.length;
        const successCount = stats.filter(s => s.correct).length;
        const rate = total ? Math.round((successCount / total) * 100) : 0;
        document.getElementById("totalQuestions").innerText = total;
        document.getElementById("successRate").innerText = rate + "%";
        
        let streak = 0;
        if (stats.length) {
            const dates = [...new Set(stats.filter(s => s.correct).map(s => s.date.split('T')[0]))].sort().reverse();
            let today = new Date().toISOString().split('T')[0];
            for (let d of dates) {
                if (d === today) streak++;
                else break;
            }
        }
        document.getElementById("streak").innerText = streak;
        
        const deg = (rate / 100) * 360;
        const circle = document.getElementById("progressCircle");
        circle.style.setProperty("--deg", deg + "deg");
        circle.innerHTML = rate + "%";
        
        const recentDiv = document.getElementById("recentStats");
        recentDiv.innerHTML = stats.slice(-5).reverse().map(s => 
            `<div style="background:#f0f8f0; border-radius:12px; padding:0.4rem; margin-bottom:0.3rem;">
                ${escapeHtml(s.question.substring(0,40))}... ${s.correct ? '✅' : '❌'} (${new Date(s.date).toLocaleDateString()})
            </div>`
        ).join('');
        if (stats.length === 0) recentDiv.innerHTML = "<p>Commence à réviser ! 🎯</p>";
    }
    
    function saveProgress(questionText, isCorrect) {
        stats.push({
            question: questionText,
            correct: isCorrect,
            date: new Date().toISOString()
        });
        if (stats.length > 500) stats = stats.slice(-500);
        localStorage.setItem("mathStats", JSON.stringify(stats));
        updateStats();
    }
    
    function resetStats() {
        if (confirm("Effacer toutes tes statistiques ?")) {
            stats = [];
            localStorage.removeItem("mathStats");
            updateStats();
        }
    }
    
    // ================= FORUM =================
    function loadForum() {
        let messages = JSON.parse(localStorage.getItem("forumMessages")) || [];
        const container = document.getElementById("forumMessages");
        if (messages.length === 0) {
            container.innerHTML = "<div class='forum-message'>💬 Sois le premier à poser une question !</div>";
            return;
        }
        container.innerHTML = messages.slice(0, 50).map(m => `
            <div class="forum-message">
                <strong>${escapeHtml(m.pseudo)}</strong> <small>${escapeHtml(m.date)}</small><br>
                ${escapeHtml(m.message)}
            </div>
        `).join('');
    }
    
    function postForumMessage() {
        const pseudo = document.getElementById("forumPseudo").value.trim();
        const msg = document.getElementById("forumMsg").value.trim();
        if (!msg) return;
        let messages = JSON.parse(localStorage.getItem("forumMessages")) || [];
        messages.unshift({
            pseudo: pseudo || "Anonyme",
            message: msg,
            date: new Date().toLocaleString('fr-FR')
        });
        if (messages.length > 100) messages.pop();
        localStorage.setItem("forumMessages", JSON.stringify(messages));
        loadForum();
        document.getElementById("forumMsg").value = "";
    }
    
    // ================= GÉNÉRATEUR ALÉATOIRE =================
    function getQuestionPool() {
        let examData = bank[currentExam];
        if (!examData) return [];
        if (currentExam === "probatoire" || currentExam === "bac") {
            if (currentSeries && examData.questions[currentSeries]) return examData.questions[currentSeries];
            return [];
        }
        return examData.questions || [];
    }
    
    function generateRandomQuestions() {
        let pool = getQuestionPool();
        if (pool.length === 0) pool = bank.college.questions;
        let shuffled = [...pool];
        for (let i = shuffled.length - 1; i > 0; i--) {
            let j = Math.floor(Math.random() * (i + 1));
            [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
        }
        return shuffled.slice(0, 5);
    }
    
    function renderExam() {
        const container = document.getElementById("examContainer");
        if (!currentQuestions.length) {
            container.innerHTML = "<p>Génère une épreuve en cliquant sur le bouton !</p>";
            return;
        }
        let html = `<div><strong>${getExamTitle()} ${currentSeries ? `- Série ${currentSeries}` : ''}</strong> (5 questions)</div>`;
        currentQuestions.forEach((q, idx) => {
            const content = q[currentLang];
            if (!content) return;
            html += `
                <div class="question-card" data-qidx="${idx}">
                    <div class="question-text">${content.text}</div>
                    <button class="correction-btn" data-idx="${idx}">🔍 Voir la correction</button>
                    <button class="feedback-btn success-btn" data-idx="${idx}" data-correct="1">✅ Je réussis</button>
                    <button class="feedback-btn fail-btn" data-idx="${idx}" data-correct="0">❌ Encore faux</button>
                    <div id="corr-${idx}" class="correction-area"></div>
                </div>
            `;
        });
        container.innerHTML = html;
        
        for (let i = 0; i < currentQuestions.length; i++) {
            const q = currentQuestions[i];
            const btnCorr = document.querySelector(`.correction-btn[data-idx="${i}"]`);
            const corrDiv = document.getElementById(`corr-${i}`);
            const answer = q[currentLang]?.answer || "Correction non disponible";
            if (btnCorr && corrDiv) {
                btnCorr.addEventListener("click", () => {
                    if (corrDiv.classList.contains("show")) {
                        corrDiv.classList.remove("show");
                        btnCorr.textContent = "🔍 Voir la correction";
                    } else {
                        corrDiv.innerHTML = `<strong>✅ Correction :</strong><br> ${answer}`;
                        corrDiv.classList.add("show");
                        btnCorr.textContent = "🙈 Masquer";
                        if (window.MathJax) MathJax.typesetPromise([corrDiv]);
                    }
                });
            }
            const successBtn = document.querySelector(`.success-btn[data-idx="${i}"]`);
            const failBtn = document.querySelector(`.fail-btn[data-idx="${i}"]`);
            if (successBtn) {
                successBtn.addEventListener("click", () => {
                    saveProgress(q[currentLang]?.text || "question", true);
                    alert("🎉 Bravo ! Continue comme ça.");
                });
            }
            if (failBtn) {
                failBtn.addEventListener("click", () => {
                    saveProgress(q[currentLang]?.text || "question", false);
                    alert("💪 Pas grave ! Regarde la correction et réessaie.");
                });
            }
        }
        if (window.MathJax) MathJax.typesetPromise();
    }
    
    function getExamTitle() {
        const titles = { college: "Collège (3ème)", bepc: "BEPC", probatoire: "Probatoire", bac: "Baccalauréat" };
        return titles[currentExam] || currentExam;
    }
    
    function updateSeriesSelector() {
        const examData = bank[currentExam];
        const container = document.getElementById("seriesContainer");
        if (currentExam === "probatoire" || currentExam === "bac") {
            let series = Object.keys(examData.questions);
            if (series.length) {
                if (!currentSeries || !series.includes(currentSeries)) currentSeries = series[0];
                let html = `<div style="display:flex; gap:0.5rem; flex-wrap:wrap;">Série : `;
                series.forEach(ser => {
                    html += `<button data-series="${ser}" class="series-btn ${currentSeries === ser ? 'active' : ''}">${ser}</button>`;
                });
                html += `</div>`;
                container.innerHTML = html;
                document.querySelectorAll(".series-btn").forEach(btn => {
                    btn.addEventListener("click", (e) => {
                        currentSeries = btn.getAttribute("data-series");
                        updateSeriesSelector();
                        generateRandomExam();
                    });
                });
                return;
            }
        }
        container.innerHTML = "";
        currentSeries = null;
    }
    
    function generateRandomExam() {
        if ((currentExam === "probatoire" || currentExam === "bac") && !currentSeries) {
            let examData = bank[currentExam];
            let first = Object.keys(examData.questions)[0];
            currentSeries = first || null;
            updateSeriesSelector();
        }
        currentQuestions = generateRandomQuestions();
        renderExam();
    }
    
    // ================= ANNALES =================
    function displayAnnales(annalesKey) {
        const data = annalesData[annalesKey];
        if (!data) return;
        let html = `<h3>📖 ${data.title}</h3>`;
        data.questions.forEach((q, idx) => {
            html += `
                <div class="question-card">
                    <div class="question-text">${q.fr.text}</div>
                    <button class="correction-btn-annales" data-ann-idx="${idx}">🔍 Voir corrigé</button>
                    <div id="annales-corr-${idx}" class="correction-area"></div>
                </div>
            `;
        });
        document.getElementById("annalesContainer").innerHTML = html;
        for (let i = 0; i < data.questions.length; i++) {
            const btn = document.querySelector(`.correction-btn-annales[data-ann-idx="${i}"]`);
            const corrDiv = document.getElementById(`annales-corr-${i}`);
            const answer = data.questions[i].fr.answer;
            if (btn && corrDiv) {
                btn.addEventListener("click", () => {
                    if (corrDiv.classList.contains("show")) {
                        corrDiv.classList.remove("show");
                        btn.textContent = "🔍 Voir corrigé";
                    } else {
                        corrDiv.innerHTML = `<strong>✅ Corrigé :</strong><br> ${answer}`;
                        corrDiv.classList.add("show");
                        btn.textContent = "🙈 Masquer";
                        if (window.MathJax) MathJax.typesetPromise([corrDiv]);
                    }
                });
            }
        }
        if (window.MathJax) MathJax.typesetPromise();
    }
    
    // ================= QUIZ CHRONO =================
    function startQuiz() {
        if (quizInterval) clearInterval(quizInterval);
        quizActive = true;
        quizTime = 600;
        quizScore = 0;
        document.getElementById("startQuiz").style.display = "none";
        document.getElementById("quizTimer").innerHTML = "10:00";
        document.getElementById("quizScore").innerHTML = "Score: 0";
        document.getElementById("quizQuestion").innerHTML = "";
        document.getElementById("quizAnswers").innerHTML = "";
        loadNextQuizQuestion();
        quizInterval = setInterval(() => {
            if (!quizActive) return;
            quizTime--;
            let minutes = Math.floor(quizTime / 60);
            let seconds = quizTime % 60;
            document.getElementById("quizTimer").innerHTML = `${minutes}:${seconds.toString().padStart(2,'0')}`;
            if (quizTime <= 0) {
                endQuiz();
            }
        }, 1000);
    }
    
    function loadNextQuizQuestion() {
        if (!quizActive) return;
        const pool = bank.bepc.questions;
        if (pool.length === 0) return;
        const randomIndex = Math.floor(Math.random() * pool.length);
        quizCurrentQuestion = pool[randomIndex];
        const questionText = quizCurrentQuestion[currentLang]?.text || "Question";
        const correctAnswer = quizCurrentQuestion[currentLang]?.answer || "";
        document.getElementById("quizQuestion").innerHTML = `<div class="question-text">${questionText}</div>`;
        document.getElementById("quizAnswers").innerHTML = `
            <input type="text" id="quizAnswerInput" placeholder="Ta réponse..." style="width:100%; padding:0.8rem; border-radius:40px; border:2px solid #ffd966; margin-top:0.5rem;">
            <button id="submitQuizAnswer" class="generate-btn" style="margin-top:0.5rem;">Valider</button>
        `;
        document.getElementById("submitQuizAnswer").onclick = () => {
            const userAnswer = document.getElementById("quizAnswerInput").value.trim().toLowerCase();
            const isCorrect = userAnswer.includes(correctAnswer.toLowerCase().replace(/[^a-z0-9]/g, '')) || 
                              (correctAnswer.toLowerCase() === userAnswer);
            if (isCorrect) {
                quizScore++;
                alert("✅ Bonne réponse ! +1 point");
                saveProgress(questionText, true);
            } else {
                alert(`❌ Mauvaise réponse. La réponse était : ${correctAnswer}`);
                saveProgress(questionText, false);
            }
            document.getElementById("quizScore").innerHTML = `Score: ${quizScore}`;
            if (quizScore >= 10) {
                endQuiz();
                return;
            }
            loadNextQuizQuestion();
        };
    }
    
    function endQuiz() {
        if (quizInterval) clearInterval(quizInterval);
        quizActive = false;
        document.getElementById("startQuiz").style.display = "block";
        document.getElementById("quizTimer").innerHTML = "";
        document.getElementById("quizQuestion").innerHTML = "";
        document.getElementById("quizAnswers").innerHTML = "";
        alert(`Quiz terminé ! Ton score : ${quizScore}/10 ⭐`);
        const pseudo = document.getElementById("forumPseudo").value.trim() || "Anonyme";
        let leaderboard = JSON.parse(localStorage.getItem("leaderboard")) || [];
        leaderboard.push({ pseudo, score: quizScore, date: new Date().toISOString() });
        leaderboard.sort((a,b) => b.score - a.score);
        leaderboard = leaderboard.slice(0, 10);
        localStorage.setItem("leaderboard", JSON.stringify(leaderboard));
        displayLeaderboard();
    }
    
    function displayLeaderboard() {
        const leaderboard = JSON.parse(localStorage.getItem("leaderboard")) || [];
        if (leaderboard.length === 0) {
            document.getElementById("leaderboard").innerHTML = "<p>💡 Fais le quiz chrono pour entrer dans le classement !</p>";
            return;
        }
        let html = "<ol>";
        leaderboard.forEach(entry => {
            html += `<li><strong>${escapeHtml(entry.pseudo)}</strong> : ${entry.score}/10 points</li>`;
        });
        html += "</ol>";
        document.getElementById("leaderboard").innerHTML = html;
    }
    
    // ================= MULTILINGUE =================
    function setLanguage(lang) {
        currentLang = lang;
        document.querySelectorAll(".lang-btn").forEach(btn => {
            if (btn.getAttribute("data-lang") === lang) btn.classList.add("active");
            else btn.classList.remove("active");
        });
        renderExam();
        const activeAnnales = document.querySelector(".annales-btn.active")?.getAttribute("data-annales");
        if (activeAnnales) displayAnnales(activeAnnales);
    }
    
    // ================= INITIALISATION =================
    function setExam(examId) {
        currentExam = examId;
        document.querySelectorAll(".exam-btn").forEach(btn => {
            if (btn.getAttribute("data-exam") === examId) btn.classList.add("active");
            else btn.classList.remove("active");
        });
        if (examId !== "probatoire" && examId !== "bac") currentSeries = null;
        updateSeriesSelector();
        generateRandomExam();
    }
    
    function copyShare() {
        const url = window.location.href;
        navigator.clipboard.writeText(url);
        alert("Lien copié ! Partage-le avec tes camarades.");
    }
    
    // Événements
    document.getElementById("generateExamBtn").onclick = generateRandomExam;
    document.getElementById("postMsgBtn").onclick = postForumMessage;
    document.getElementById("startQuiz").onclick = startQuiz;
    document.getElementById("resetStats").onclick = resetStats;
    document.querySelectorAll(".exam-btn").forEach(btn => btn.onclick = () => setExam(btn.getAttribute("data-exam")));
    document.querySelectorAll(".annales-btn").forEach(btn => btn.onclick = () => {
        document.querySelectorAll(".annales-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        displayAnnales(btn.getAttribute("data-annales"));
    });
    document.querySelectorAll(".lang-btn").forEach(btn => btn.onclick = () => setLanguage(btn.getAttribute("data-lang")));
    
    document.getElementById("shareUrl").value = window.location.href;
    
    // Lancement
    setExam("college");
    loadForum();
    updateStats();
    displayLeaderboard();
    displayAnnales("bepc2025");
</script>
